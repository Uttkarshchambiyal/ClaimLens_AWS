# AI Model Provider: 'mock' for local development, 'sagemaker' for production
AI_MODEL_PROVIDER=mock

# AWS / SageMaker Configuration (when AI_MODEL_PROVIDER=sagemaker)
AWS_REGION=ap-south-1
SAGEMAKER_ENDPOINT_NAME=claimlens-assistant-endpoint
SAGEMAKER_MODEL_NAME=meta-llama-3-8b-instruct

# Agent Context & Memory Tuning
AI_MAX_CONTEXT_SIZE=8192
AI_SESSION_TTL=86400
DEFAULT_TENANT=default
