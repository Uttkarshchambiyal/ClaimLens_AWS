{
    "name": "claimlens-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "dev:mock": "VITE_APP_MODE=mock vite --host 127.0.0.1",
        "build": "tsc -p tsconfig.app.json --noEmit && vite build",
        "preview": "vite preview --host 127.0.0.1",
        "test": "vitest run",
        "build:demo": "VITE_APP_MODE=mock npm run build",
        "format": "prettier --write src vite.config.ts vitest.config.ts",
        "format:check": "prettier --check src vite.config.ts vitest.config.ts"
    },
    "dependencies": {
        "@radix-ui/react-collapsible": "^1.1.20",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-separator": "^1.1.15",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-react": "latest",
        "aws-amplify": "^6.20.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "gsap": "^3.15.0",
        "lucide-react": "latest",
        "oidc-client-ts": "latest",
        "pdfjs-dist": "^6.3.289",
        "react": "latest",
        "react-dom": "latest",
        "recharts": "^3.10.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "three": "^0.186.0",
        "tw-animate-css": "^1.4.0",
        "vite": "latest"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^22.20.3",
        "@types/react": "latest",
        "@types/react-dom": "latest",
        "@types/three": "^0.186.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.7",
        "typescript": "latest",
        "vitest": "^5.0.1"
    }
}
